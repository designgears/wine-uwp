#!/usr/bin/env bash
# wine-uwp: set up and run UWP apps in an installed wine-uwp (an AppImage or a plain tree).
#
#   wine-uwp                  the setup UI, which is also the launcher and updater once an app is installed (a
#                             build with no setup UI runs the app)
#   wine-uwp start            the app if one is installed, the setup otherwise (a menu entry's command)
#   wine-uwp setup            the setup UI (when the build ships one)
#   wine-uwp run [APP]        run an installed app (default: the first one installed)
#   wine-uwp list             installed apps
#   wine-uwp stop [APP]       close a running app (it gets a moment to exit, then Wine is ended)
#   wine-uwp activate URI     hand a URI (a browser sign-in's callback) to the app that owns its scheme
#   wine-uwp harvest ISO      extract the Windows files from an ISO     (command-line setup, step 1)
#   wine-uwp new-prefix       build the Wine prefix from them            (step 2)
#   wine-uwp install PACKAGE  install an .msixbundle/.msix/.appx         (step 3)
#   wine-uwp install-store ID download and install a Store app by Store id (9PCDNBHR11MR) or package family; an
#                             encrypted one with your account's licence (signs in through the browser if needed)
#   wine-uwp info PACKAGE [ICON]  describe a package as JSON (and write its logo to ICON)
#   wine-uwp latest APPINSTALLER  the version an .appinstaller (file or URL) serves
#
# Everything the user owns lives in one data directory, $WINE_UWP_DATA, by default
# $XDG_DATA_HOME/wine-uwp:
#   windows/  the files harvested from the Windows ISO     prefix/  the Wine prefix
#   stage/    installed apps and their frameworks          logs/    one log per app
set -euo pipefail
bin=$(dirname "$(readlink -f "$0")")
root=$(cd "$bin/../share/wine-uwp" && pwd)
data=${WINE_UWP_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/wine-uwp}
mkdir -p "$data/logs"
export WINE_UWP_ROOT=$root UWP_BIN=$data WIN11=$data/windows WINEPREFIX=$data/prefix
export WINE_BUILD=$bin SHIM_DIR=$root/shims PY=${PY:-python3}
export WINEDEBUG=${WINEDEBUG:--all,err+all}

# is APP running from this data directory? "run" holds a lock on logs/.APP.running for as long as the app lives. A
# lock in the shared data directory is seen from every sandbox: each Flatpak instance has its own process namespace,
# so the app is invisible in another instance's /proc, and a sign-in link would start a second copy.
running() { ! flock -n "$data/logs/.$1.running" true 2>/dev/null; }
# (APP.new and APP.old are an update in progress, not apps)
installed() { for d in "$data"/stage/*/identity.env; do case $d in *.new/*|*.old/*) continue ;; esac; [ -f "$d" ] && basename "$(dirname "$d")"; done; true; }

cmd=${1:-}
[ $# -gt 0 ] && shift
# a desktop scheme handler passes the URI itself ("wine-uwp %u")
case $cmd in *:*) set -- "$cmd"; cmd=activate ;; esac
if [ "$cmd" = start ]; then
  # a menu entry that is also the scheme handler ("wine-uwp start %u") gets the URI here
  case ${1:-} in *:*) cmd=activate ;; *) set -- ;; esac
fi
if [ "$cmd" = start ]; then
  if [ -f "$data/prefix/.wine-uwp-ready" ] && [ -n "$(installed)" ]; then cmd=run; else cmd=setup; fi
elif [ -z "$cmd" ]; then
  if [ -x "$bin/wine-uwp-installer" ] || ! [ -f "$data/prefix/.wine-uwp-ready" ] || [ -z "$(installed)" ]; then
    cmd=setup
  else
    cmd=run
  fi
fi
case $cmd in
  setup)
    # a product's setup UI, when it ships one; otherwise the three command-line steps
    [ -x "$bin/wine-uwp-installer" ] && exec "$bin/wine-uwp-installer" "$@"
    echo "no setup UI in this build; set up from the command line:" >&2
    echo "  wine-uwp harvest ISO; wine-uwp new-prefix; wine-uwp install PACKAGE" >&2
    exit 2 ;;
  list)       installed ;;
  run)
    app=${1:-$(installed | head -1)}
    [ -n "$app" ] && [ -f "$data/stage/$app/identity.env" ] || { echo "no installed app ${app:+named $app}" >&2; exit 1; }
    # one copy per data directory: the lock is held by run.sh and everything it starts (they inherit fd 9)
    exec 9> "$data/logs/.$app.running"
    flock -n 9 || { echo "$app is already running" >&2; exit 0; }
    # "stop": the setup UI asks a running app to close (before an update) by creating logs/.APP.stop. A file, because
    # the asker may be another Flatpak instance, which can neither see this one's processes nor reach its wineserver.
    # The watcher closes fd 9, or it would keep the lock after the app is gone.
    rm -f "$data/logs/.$app.stop"
    ( exec 9>&-; while kill -0 $$ 2>/dev/null; do
        if [ -e "$data/logs/.$app.stop" ]; then rm -f "$data/logs/.$app.stop"; "$bin/wineserver" -k; fi
        sleep 1
      done ) &
    UWP_STAGE=$app UWP_TIMEOUT=0 UWP_LOG="$data/logs/$app.log" exec "$root/run.sh" ;;
  stop)
    app=${1:-$(installed | head -1)}
    running "$app" || exit 0
    touch "$data/logs/.$app.stop"
    for _ in $(seq 30); do running "$app" || exit 0; sleep 0.5; done
    echo "$app did not close" >&2; exit 1 ;;
  harvest)    exec python3 "$root/packaging/harvest/harvest.py" "$1" "$data/windows" ;;
  new-prefix) "$root/packaging/new-prefix.sh" "$data/windows" "$data/prefix"; touch "$data/prefix/.wine-uwp-ready" ;;
  activate)
    # the desktop's handler for an app's URI scheme: wineuwp in the running app watches this inbox and
    # delivers it as a Protocol activation (activate-uri.sh in the checkout does the same)
    uri=${1:?usage: wine-uwp activate URI}
    scheme=${uri%%:*}
    app=""
    for a in $(installed); do grep -qxi "$scheme" "$data/stage/$a/.wine-uwp-protocols" 2>/dev/null && app=$a; done
    [ -n "$app" ] || { echo "no installed app owns $scheme:" >&2; exit 1; }
    inbox="$data/prefix/drive_c/users/Public/wineuwp-activate.uri"
    printf '%s' "$uri" > "$inbox.tmp" && mv -f "$inbox.tmp" "$inbox"
    # not running: start it, and it picks the inbox up when it starts watching
    # from an AppImage, start a new instance of it: this one's mount goes away when it exits
    running "$app" || (setsid "${APPIMAGE:-$0}" run "$app" >/dev/null 2>&1 &) ;;
  # Wine's appxinstall, through its command line (programs/wineuwp-install): Unix paths are fine
  install)    PATH="$bin:$PATH" exec wine wineuwp-install "${1:?usage: wine-uwp install PACKAGE}" "$data" --windows "$data/windows" ;;
  install-store) PATH="$bin:$PATH" exec wine wineuwp-install "${1:?usage: wine-uwp install-store STOREID|FAMILY}" "$data" \
                --windows "$data/windows" --store ;;
  info)       PATH="$bin:$PATH" exec wine wineuwp-install "${1:?usage: wine-uwp info PACKAGE [ICON]}" "$data" --info \
                --windows "$data/windows" ${2:+--icon "$2"} ;;
  latest)     PATH="$bin:$PATH" exec wine wineuwp-install "${1:?usage: wine-uwp latest APPINSTALLER}" --latest ;;
  *)          sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
