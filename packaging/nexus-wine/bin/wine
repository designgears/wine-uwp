#!/bin/bash
# wine-uwp as the "Wine" of Xodus Nexus (github.com/domsvoboda/xodus-nexus).
#
# Nexus runs a game as `<winePath> <exe> ...` through its backend (`xodus-cli run`), with WINEPREFIX set to its own
# legacy prefix when the path is not a Proton tree. Point Settings > "Wine / Xodus Proton binary" at this file and
# the game runs on our Wine instead: our build, our prefix (with the shims and Windows components wine-uwp installs),
# the package identity our GDK runtime reads, and the launch defaults every wine-uwp app gets.
#
# Called as `wineserver` (the link beside it) it is our wineserver for the same prefix.
#
#   NEXUS_WINE_PREFIX   the prefix to use (default: uwp-bin/prefix-nexus); Nexus's WINEPREFIX is ignored
#   NEXUS_WINE_BUILD    the Wine build tree (default: uwp-bin/wine-build-wow64, which has 32-bit support)
#   NEXUS_WINE_LOG      where each invocation is logged (default: uwp-bin/logs/nexus-wine.log)
set -u
here=$(dirname "$(readlink -f "$0")")
root=$(readlink -f "$here/../../..")
UWP_BIN=${UWP_BIN:-$root/uwp-bin}
build=${NEXUS_WINE_BUILD:-$UWP_BIN/wine-build-wow64}
export WINEPREFIX=${NEXUS_WINE_PREFIX:-$UWP_BIN/prefix-nexus}
log=${NEXUS_WINE_LOG:-$UWP_BIN/logs/nexus-wine.log}
mkdir -p "$(dirname "$log")"
export PATH="$build:$PATH"
unset WINEARCH
self=$(basename "$0")

if [ "$self" = wineserver ]; then
    echo "$(date '+%F %T') wineserver $*" >> "$log"
    exec "$build/server/wineserver" "$@"
fi

echo "$(date '+%F %T') wine $* (cwd $PWD, nexus prefix ${NEXUS_ORIGINAL_PREFIX:-})" >> "$log"

# The launch defaults of every wine-uwp app (renderer, native component overrides, ...), unless already set.
while IFS= read -r line; do
    case "$line" in
        export\ *=*) name=${line#export }; name=${name%%=*}
                     [ -z "${!name+x}" ] && eval "$line" ;;
    esac
done < "$root/launch-defaults.env"
export WINE_HACK_NATIVE_SYSCALLS=${WINE_HACK_NATIVE_SYSCALLS:-1}

# Package identity, from the manifest of the package the executable belongs to (GDK runtime, XPackage, ...).
for arg in "$@"; do
    case "$arg" in
        *.exe|*.EXE)
            if env=$(python3 "$here/../identity.py" "$arg" 2>>"$log"); then
                eval "$env"
                echo "  identity: ${WINE_UWP_PACKAGE_FULL_NAME:-none} at ${WINE_UWP_PACKAGE_PATH:-?}" >> "$log"
            fi
            break ;;
    esac
done

exec "$build/wine" "$@"
