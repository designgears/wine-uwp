# What every packaged app is started with, besides its own identity. run.sh reads this (a variable already set
# in the environment wins), and packaging/install-app.py copies it into each app's launch.env for
# wineuwp-launch.exe. One list, so the two ways of starting an app cannot drift apart.
#
# Skip DLL_THREAD_ATTACH/DETACH into native DLLs: see Findings-M4.md, loader-lock deadlocks.
export WINE_SKIP_NATIVE_THREAD_CALLS=1
# wined3d's OpenGL path stalls XAML's first frame on the NVIDIA desktop; the Vulkan renderer works everywhere.
export WINE_D3D_CONFIG=renderer=vulkan
# DLLs where Wine's builtin must yield to the extracted Windows copy. Wine also ships these names.
# msvcp140_app=b the other way round: apps built with STL 14.40 or later (Shapr3D 26.180) have a constexpr std::mutex
# that the ISO's VCLibs 14.0.30704 C++ runtime dereferences as NULL in _Mtx_lock; Wine's has the new layout.
export WINEDLLOVERRIDES='windows.ui.xaml=n;windows.ui=n;twinapi.appcore=n;coremessaging=n;windows.applicationmodel=n;wintypes=n;threadpoolwinrt=n;msvcp_win=n;bcp47mrm=n;bcp47langs=n;profapi=n;rometadata=n;windows.globalization=n;msftedit=n;msxml6=n;cryptowinrt=n;msvcp140_app=b'
# NVIDIA's shader disk cache evicts past its size limit (1 GB), and a D3D12 game fills that: Gears of War 4 hitched
# again in places already played. Keep everything, as Steam does for its games.
export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
# the launch size; a window covering the whole screen cannot be resized through the frame
export WINE_UWP_WINDOW_SIZE=1280x800
