+                c.Rip = *(ULONG64 *)c.Rsp;
+                c.Rsp += 8;
+            }
+            else RtlVirtualUnwind(UNW_FLAG_NHANDLER, base, c.Rip, func, &c, &handler_data, &frame, NULL);
+        }
+    }
+    __EXCEPT_ALL { ERR("[DEBUG-resume] unwind fault\n"); }
+    __ENDTRY
+    return EXCEPTION_CONTINUE_SEARCH;
+}
