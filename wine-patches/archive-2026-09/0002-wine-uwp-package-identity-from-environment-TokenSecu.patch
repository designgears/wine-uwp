+/* Package identity for hosted UWP apps, see kernelbase/version.c for the variables. */
+static NTSTATUS get_package_env( const WCHAR *var, WCHAR *buffer, SIZE_T *size )
+{
+    UNICODE_STRING name, value;
+    WCHAR tmp[1024];
+    NTSTATUS status;
+    SIZE_T len;
+
+    RtlInitUnicodeString( &name, var );
+    value.Buffer = tmp;
+    value.MaximumLength = sizeof(tmp);
+    if ((status = RtlQueryEnvironmentVariable_U( NULL, &name, &value ))) return STATUS_NOT_FOUND;
+    len = value.Length / sizeof(WCHAR) + 1;
+    if (!size) return STATUS_SUCCESS;
+    if (!buffer || *size < len)
+    {
+        *size = len;
+        return STATUS_BUFFER_TOO_SMALL;
+    }
+    *size = len;
+    memcpy( buffer, tmp, len * sizeof(WCHAR) );
+    return STATUS_SUCCESS;
+}
+
 /*********************************************************************
  *           RtlQueryPackageIdentity [NTDLL.@]
  */
 NTSTATUS WINAPI RtlQueryPackageIdentity(HANDLE token, WCHAR *fullname, SIZE_T *fullname_size,
                                         WCHAR *appid, SIZE_T *appid_size, BOOLEAN *packaged)
 {
-    FIXME("(%p, %p, %p, %p, %p, %p): stub\n", token, fullname, fullname_size, appid, appid_size, packaged);
-    return STATUS_NOT_FOUND;
+    NTSTATUS status;
+
+    TRACE("(%p, %p, %p, %p, %p, %p)\n", token, fullname, fullname_size, appid, appid_size, packaged);
+
+    if ((status = get_package_env( L"WINE_UWP_PACKAGE_FULL_NAME", fullname, fullname_size ))) return status;
+    if (appid_size && (status = get_package_env( L"WINE_UWP_AUMID", appid, appid_size ))) return status;
+    if (packaged) *packaged = TRUE;
+    return STATUS_SUCCESS;
 }
 
+#define PSM_ACTIVATION_TOKEN_PACKAGED_APPLICATION 0x01
+#define PSM_ACTIVATION_TOKEN_DEVELOPMENT_APP      0x10
+#define PACKAGE_ORIGIN_DEVELOPER_UNSIGNED 4
+
 /*********************************************************************
  *           RtlQueryPackageClaims [NTDLL.@]
  *
- * Queried by Windows.UI.Xaml.dll during Application init. Windows returns
- * STATUS_NOT_FOUND for processes without package identity.
+ * Queried by Windows.UI.Xaml.dll during Application init: it fail-fasts unless
+ * this succeeds with the PACKAGED_APPLICATION flag set.
  */
 NTSTATUS WINAPI RtlQueryPackageClaims(HANDLE token, WCHAR *fullname, SIZE_T *fullname_size,
                                       WCHAR *appid, SIZE_T *appid_size, GUID *dynamic_id,
-                                      void *pkg_claim, ULONG64 *attributes_present)
+                                      ULONG64 *pkg_claim, ULONG64 *attributes_present)
 {
-    FIXME("(%p, %p, %p, %p, %p, %p, %p, %p): stub\n", token, fullname, fullname_size,
+    NTSTATUS status;
+
+    TRACE("(%p, %p, %p, %p, %p, %p, %p, %p)\n", token, fullname, fullname_size,
           appid, appid_size, dynamic_id, pkg_claim, attributes_present);
+
+    if ((status = get_package_env( L"WINE_UWP_PACKAGE_FULL_NAME", fullname, fullname_size ))) return status;
+    if (appid_size && (status = get_package_env( L"WINE_UWP_AUMID", appid, appid_size ))) return status;
+    if (dynamic_id) memset( dynamic_id, 0, sizeof(*dynamic_id) );
+    if (pkg_claim)
+    {
+        pkg_claim[0] = PSM_ACTIVATION_TOKEN_PACKAGED_APPLICATION | PSM_ACTIVATION_TOKEN_DEVELOPMENT_APP; /* Flags */
+        pkg_claim[1] = PACKAGE_ORIGIN_DEVELOPER_UNSIGNED;                                                 /* Origin */
+    }
     if (attributes_present) *attributes_present = 0;
-    return STATUS_NOT_FOUND;
+    return STATUS_SUCCESS;
 }
 
 /*********************************************************************
diff --git a/dlls/ntdll/unix/security.c b/dlls/ntdll/unix/security.c
index 70dfe21..f104fb0 100644
--- a/dlls/ntdll/unix/security.c
+++ b/dlls/ntdll/unix/security.c
@@ -643,6 +643,75 @@ NTSTATUS WINAPI NtQueryInformationToken( HANDLE token, TOKEN_INFORMATION_CLASS c
             break;
         }
 
+    case TokenSecurityAttributes:
+        {
+            /* Package identity claims for hosted UWP apps (see kernelbase/version.c). Layout follows the
+             * kernel-mode TOKEN_SECURITY_ATTRIBUTES_INFORMATION: names and string values are UNICODE_STRINGs
+             * pointing inside the returned buffer. twinapi.appcore and kernel.appcore read WIN://SYSAPPID. */
+            struct attr_info { USHORT Version; USHORT Reserved; ULONG AttributeCount; void *pAttributeV1; };
+            struct attr_v1 { UNICODE_STRING Name; USHORT ValueType; USHORT Reserved; ULONG Flags; ULONG ValueCount; void *Values; };
+            static const WCHAR sysappid[] = {'W','I','N',':','/','/','S','Y','S','A','P','P','I','D',0};
+            static const WCHAR pkgname[]  = {'W','I','N',':','/','/','P','K','G',0};
+            const char *aumid = getenv( "WINE_UWP_AUMID" ), *family = getenv( "WINE_UWP_PACKAGE_FAMILY_NAME" ),
+                       *full = getenv( "WINE_UWP_PACKAGE_FULL_NAME" );
+            const char *strs[3] = { aumid, family, full };
+            WCHAR *wstrs[3];
+            struct attr_info *hdr;
+            struct attr_v1 *attrs;
+            UNICODE_STRING *values;
+            ULONG64 *pkg;
+            char *ptr;
+            ULONG i, needed, count = 0;
+            DWORD lens[3];
+
+            if (!full) { status = STATUS_NOT_FOUND; break; }
+            for (i = 0; i < 3; i++) if (strs[i]) count++;
+            needed = sizeof(*hdr) + 2 * sizeof(*attrs) + sizeof(sysappid) + sizeof(pkgname) + sizeof(ULONG64)
+                     + count * sizeof(UNICODE_STRING);
+            for (i = 0; i < 3; i++)
+            {
+                if (!strs[i]) continue;
+                lens[i] = ntdll_umbstowcs( strs[i], strlen(strs[i]), NULL, 0 );
+                needed += (lens[i] + 1) * sizeof(WCHAR);
+            }
+            if (retlen) *retlen = needed;
+            if (length < needed) { status = STATUS_BUFFER_TOO_SMALL; break; }
+
+            hdr = info;
+            hdr->Version = 1; hdr->Reserved = 0; hdr->AttributeCount = 2;
+            attrs = (struct attr_v1 *)(hdr + 1);
+            hdr->pAttributeV1 = attrs;
+            values = (UNICODE_STRING *)(attrs + 2);
+            pkg = (ULONG64 *)(values + count);
+            ptr = (char *)(pkg + 1);
+
+            /* WIN://SYSAPPID: string values AUMID, package family name, package full name */
+            attrs[0].Name.Buffer = (WCHAR *)ptr; memcpy( ptr, sysappid, sizeof(sysappid) ); ptr += sizeof(sysappid);
+            attrs[0].Name.Length = sizeof(sysappid) - sizeof(WCHAR); attrs[0].Name.MaximumLength = sizeof(sysappid);
+            attrs[0].ValueType = 3 /* TOKEN_SECURITY_ATTRIBUTE_TYPE_STRING */; attrs[0].Reserved = 0;
+            attrs[0].Flags = 0x0001 /* NON_INHERITABLE */; attrs[0].ValueCount = count; attrs[0].Values = values;
+            for (i = 0, count = 0; i < 3; i++)
+            {
+                if (!strs[i]) continue;
+                wstrs[i] = (WCHAR *)ptr;
+                ntdll_umbstowcs( strs[i], strlen(strs[i]), wstrs[i], lens[i] );
+                wstrs[i][lens[i]] = 0;
+                values[count].Buffer = wstrs[i];
+                values[count].Length = lens[i] * sizeof(WCHAR);
+                values[count].MaximumLength = (lens[i] + 1) * sizeof(WCHAR);
+                ptr += (lens[i] + 1) * sizeof(WCHAR);
+                count++;
