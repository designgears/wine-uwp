From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wine-uwp contributors <wine-uwp@example.invalid>
Date: Sat, 12 Sep 2026 00:00:00 -0600
Subject: [PATCH] dcomp: accept Calculator's scalar animation registration

Calculator creates a scalar key-frame animation while laying out its first
post-navigation content. Returning E_NOTIMPL from the factory, or from slot 8
of the private compositor interface queried immediately afterward, causes
XAML to stow E_NOTIMPL and abort the render walk.

The object remains a recording stand-in; timeline behavior is still absent.
---
 dlls/dcomp/composition.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/dlls/dcomp/composition.c b/dlls/dcomp/composition.c
--- a/dlls/dcomp/composition.c
+++ b/dlls/dcomp/composition.c
@@ -176,1 +176,7 @@
-PROBE_STUB(6)  PROBE_STUB(7)  PROBE_STUB(8)  PROBE_STUB(9)  PROBE_STUB(10) PROBE_STUB(11)
+PROBE_STUB(6)  PROBE_STUB(7)  PROBE_STUB(9)  PROBE_STUB(10) PROBE_STUB(11)
+/* Private5 slot 8 is a harmless registration call on Calculator's path. */
+static HRESULT WINAPI probe_slot_8( void *iface )
+{
+    TRACE( "private compositor slot 8: accepted.\\n" );
+    return S_OK;
+}
@@ -3105,1 +3111,8 @@
-COMPOSITOR_STUB( CreateScalarKeyFrameAnimation, ( ICompositor *iface, IScalarKeyFrameAnimation **result ), *result = NULL )
+static HRESULT WINAPI compositor_CreateScalarKeyFrameAnimation( ICompositor *iface,
+                                                                IScalarKeyFrameAnimation **result )
+{
+    TRACE( "iface %p.\\n", iface );
+    /* A recording object lets XAML continue until timeline behavior is implemented. */
+    if (!result) return E_POINTER;
+    return create_comp_object( "ScalarKeyFrameAnimation", (void **)result );
+}
