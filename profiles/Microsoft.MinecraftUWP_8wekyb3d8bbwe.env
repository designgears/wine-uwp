# Minecraft for Windows, the UWP releases (up to 1.21.51; later ones are GDK). See profiles/README.md.
#
# DXVK and vkd3d-proton: on wined3d the game's flip-model swap chain queued frames and the mouse lagged badly.
# The installer links the D3D runtime beside the exe for WINE_UWP_NATIVE_D3D=1; the adapter makes DXVK take the
# app's CoreWindow. Do not set WINE_UWP_DRIVE_FIRST_VIEW: it hangs the game's start-up.
WINE_UWP_NATIVE_D3D=1
WINEDLLOVERRIDES+=dxgi=n;d3d11=n;d3d12=n;d3d12core=n
WINE_UWP_DXVK_COREWINDOW=1
# Xbox Live tokens bound to Bedrock's title, through its Android sign-in client (it shares the multiplayer service
# config): without them a world says the account is disconnected. The first interactive sign-in asks for this
# client's approval in the browser too.
WINE_UWP_XBOX_TITLE_APP=0000000048183522
WINE_UWP_XBOX_TITLE_ID=1739947436
