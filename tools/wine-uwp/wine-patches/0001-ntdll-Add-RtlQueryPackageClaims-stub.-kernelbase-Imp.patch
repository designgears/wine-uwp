From 8232b4c689b27b877733b336cc9363493c400450 Mon Sep 17 00:00:00 2001
From: designgears <bobby@designgears.com>
Date: Wed, 9 Sep 2026 17:05:32 -0600
Subject: [PATCH 1/3] ntdll: Add RtlQueryPackageClaims stub. kernelbase:
 Implement CheckTokenMembershipEx.

Both are hit by Windows.UI.Xaml.dll / MrmCoreR.dll when hosting a UWP app.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 dlls/kernelbase/kernelbase.spec |  2 +-
 dlls/kernelbase/security.c      | 11 +++++++++++
 dlls/ntdll/ntdll.spec           |  1 +
 dlls/ntdll/rtl.c                | 16 ++++++++++++++++
 4 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/dlls/kernelbase/kernelbase.spec b/dlls/kernelbase/kernelbase.spec
index 16417a4..99305c9 100644
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -131,7 +131,7 @@
 @ stdcall CheckRemoteDebuggerPresent(long ptr)
 # @ stub CheckTokenCapability
 @ stdcall CheckTokenMembership(long ptr ptr)
-# @ stub CheckTokenMembershipEx
+@ stdcall CheckTokenMembershipEx(long ptr long ptr)
 @ stdcall ChrCmpIA(long long)
 @ stdcall ChrCmpIW(long long)
 @ stdcall ClearCommBreak(long)
diff --git a/dlls/kernelbase/security.c b/dlls/kernelbase/security.c
index 6231c48..38b8e9b 100644
--- a/dlls/kernelbase/security.c
+++ b/dlls/kernelbase/security.c
@@ -538,6 +538,17 @@ BOOL WINAPI AdjustTokenPrivileges( HANDLE token, BOOL disable, PTOKEN_PRIVILEGES
     return (status == STATUS_SUCCESS) || (status == STATUS_NOT_ALL_ASSIGNED);
 }
 
+/******************************************************************************
+ * CheckTokenMembershipEx    (kernelbase.@)
+ *
+ * Used by MrmCoreR.dll (ms-appx resource loading) through api-ms-win-security-base-l1-2-0.
+ */
+BOOL WINAPI CheckTokenMembershipEx( HANDLE token, PSID sid_to_check, DWORD flags, PBOOL is_member )
+{
+    if (flags) FIXME( "flags %#lx ignored\n", flags );
+    return CheckTokenMembership( token, sid_to_check, is_member );
+}
+
 /******************************************************************************
  * CheckTokenMembership    (kernelbase.@)
  */
diff --git a/dlls/ntdll/ntdll.spec b/dlls/ntdll/ntdll.spec
index 2c66313..f129a17 100644
--- a/dlls/ntdll/ntdll.spec
+++ b/dlls/ntdll/ntdll.spec
@@ -953,6 +953,7 @@
 @ stdcall RtlQueryInformationActivationContext(long long ptr long ptr long ptr)
 @ stdcall RtlQueryInformationActiveActivationContext(long ptr long ptr)
 @ stub RtlQueryInterfaceMemoryStream
+@ stdcall RtlQueryPackageClaims(long ptr ptr ptr ptr ptr ptr ptr)
 @ stdcall RtlQueryPackageIdentity(long ptr ptr ptr ptr ptr)
 @ stdcall RtlQueryPerformanceCounter(ptr)
 @ stdcall RtlQueryPerformanceFrequency(ptr)
diff --git a/dlls/ntdll/rtl.c b/dlls/ntdll/rtl.c
index 0423165..1cd9c19 100644
--- a/dlls/ntdll/rtl.c
+++ b/dlls/ntdll/rtl.c
@@ -1630,6 +1630,22 @@ NTSTATUS WINAPI RtlQueryPackageIdentity(HANDLE token, WCHAR *fullname, SIZE_T *f
     return STATUS_NOT_FOUND;
 }
 
+/*********************************************************************
+ *           RtlQueryPackageClaims [NTDLL.@]
+ *
+ * Queried by Windows.UI.Xaml.dll during Application init. Windows returns
+ * STATUS_NOT_FOUND for processes without package identity.
+ */
+NTSTATUS WINAPI RtlQueryPackageClaims(HANDLE token, WCHAR *fullname, SIZE_T *fullname_size,
+                                      WCHAR *appid, SIZE_T *appid_size, GUID *dynamic_id,
+                                      void *pkg_claim, ULONG64 *attributes_present)
+{
+    FIXME("(%p, %p, %p, %p, %p, %p, %p, %p): stub\n", token, fullname, fullname_size,
+          appid, appid_size, dynamic_id, pkg_claim, attributes_present);
+    if (attributes_present) *attributes_present = 0;
+    return STATUS_NOT_FOUND;
+}
+
 /*********************************************************************
  *           RtlQueryProcessPlaceholderCompatibilityMode [NTDLL.@]
  */
-- 
